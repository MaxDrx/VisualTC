{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_PREFIX_PATH": "$env{QT_ROOT_DIR}"
      }
    },
    {
      "name": "vcpkg",
      "hidden": true,
      "inherits": "base",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
    },
    {
      "name": "linux-release",
      "displayName": "Linux (GCC/Clang) Release",
      "inherits": "vcpkg",
      "generator": "Ninja",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    },
    {
      "name": "linux-debug-asan",
      "displayName": "Linux Debug + AddressSanitizer/UBSan",
      "inherits": "vcpkg",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "VISUALTC_ENABLE_SANITIZERS": "ON",
        "CMAKE_MAP_IMPORTED_CONFIG_DEBUG": "Release;"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    },
    {
      "name": "linux-local",
      "displayName": "Linux with locally built dependencies (/opt/visualtc-deps)",
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_PREFIX_PATH": "/opt/visualtc-deps;/opt/visualtc-deps/qt6"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    },
    {
      "name": "windows-msvc-release",
      "displayName": "Windows x64 (MSVC) Release",
      "inherits": "vcpkg",
      "generator": "Visual Studio 17 2022",
      "architecture": { "value": "x64", "strategy": "set" },
      "cacheVariables": { "VCPKG_TARGET_TRIPLET": "x64-windows" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "macos-arm64-release",
      "displayName": "macOS Apple Silicon (arm64) Release",
      "inherits": "vcpkg",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "12.0",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/cmake/triplets",
        "VCPKG_TARGET_TRIPLET": "arm64-osx-visualtc"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" }
    },
    {
      "name": "macos-x86_64-release",
      "displayName": "macOS Intel (x86_64) Release",
      "inherits": "vcpkg",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_OSX_ARCHITECTURES": "x86_64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "12.0",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/cmake/triplets",
        "VCPKG_TARGET_TRIPLET": "x64-osx-visualtc"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" }
    }
  ],
  "buildPresets": [
    { "name": "linux-release", "configurePreset": "linux-release" },
    { "name": "linux-debug-asan", "configurePreset": "linux-debug-asan" },
    { "name": "linux-local", "configurePreset": "linux-local" },
    { "name": "windows-msvc-release", "configurePreset": "windows-msvc-release", "configuration": "Release" },
    { "name": "macos-arm64-release", "configurePreset": "macos-arm64-release" },
    { "name": "macos-x86_64-release", "configurePreset": "macos-x86_64-release" }
  ],
  "testPresets": [
    {
      "name": "base-test",
      "hidden": true,
      "output": { "outputOnFailure": true },
      "environment": { "QT_QPA_PLATFORM": "offscreen" }
    },
    { "name": "linux-release", "inherits": "base-test", "configurePreset": "linux-release" },
    { "name": "linux-debug-asan", "inherits": "base-test", "configurePreset": "linux-debug-asan" },
    { "name": "linux-local", "inherits": "base-test", "configurePreset": "linux-local" },
    { "name": "windows-msvc-release", "inherits": "base-test", "configurePreset": "windows-msvc-release", "configuration": "Release" },
    { "name": "macos-arm64-release", "inherits": "base-test", "configurePreset": "macos-arm64-release" },
    { "name": "macos-x86_64-release", "inherits": "base-test", "configurePreset": "macos-x86_64-release" }
  ]
}
